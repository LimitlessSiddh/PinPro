# Copy to .env and fill in. Never commit .env.

# Postgres connection string (SSL is enabled automatically when NODE_ENV=production)
DATABASE_URL=postgres://user:password@localhost:5432/pinpro
NODE_ENV=development
# Defaults to 5050 if unset
PORT=5050

# Signs username/password login tokens. Falls back to 'dev_secret' if unset — always set it in production.
JWT_SECRET=change-me

# Firebase Admin service account (Firebase console → Project settings → Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste with literal \n sequences; the code converts them to newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
